{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // This Worker has no code: it only serves static assets. That's why it
  // doesn't carry "main". If a future phase needs to hide the Stadia key
  // behind a proxy, that code goes here as "main" and lives alongside the assets.
  "name": "games-map",
  "compatibility_date": "2026-09-07",

  "assets": {
    // Relative to the repo root, which is the build's Root directory.
    "directory": "./app/dist",
    // Any route not found returns index.html with 200, instead of 404.
    "not_found_handling": "single-page-application"
  }
}
