{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Este Worker no tiene codigo: solo sirve archivos estaticos. Por eso no
  // lleva "main". Cuando la fase 2 necesite esconder la clave de Stadia detras
  // de un proxy, ese codigo entra aqui como "main" y convive con los assets.
  "name": "games-map",
  "compatibility_date": "2026-09-07",

  "assets": {
    // Relativo a la raiz del repo, que es el Root directory del build.
    "directory": "./app/dist",
    // Cualquier ruta no encontrada devuelve index.html con 200, en vez de 404.
    "not_found_handling": "single-page-application"
  }
}
